create or replace transient table MARKETING_DB.dbt_test_failures.source_unique_raw_raw_conversions_conversion_id
         as
        (
    
    

select
    conversion_id as unique_field,
    count(*) as n_records

from MARKETING_DB.RAW.raw_conversions
where conversion_id is not null
group by conversion_id
