create or replace transient table MARKETING_DB.dbt_test_failures.assert_revenue_conserved
         as
        (-- Total revenue must be conserved across all 5 attribution models.
-- (Each model redistributes the same revenue universe; sums should be ≈ equal.)

with totals as (
    select model, sum(attributed_revenue) as total_attributed
      from MARKETING_DB.ANALYTICS.mart_channel_roas_compared
     group by 1
),
expected as (
    select sum(revenue) as expected_total from MARKETING_DB.RAW.stg_conversions
)
select t.model, t.total_attributed, e.expected_total,
       abs(t.total_attributed - e.expected_total) as delta
  from totals t
 cross join expected e
 where abs(t.total_attributed - e.expected_total) > e.expected_total * 0.10
        );
